  telescopeMessage: Ves como tu amigo se aleja en el cohete
  telescopeDuration: -1
  wakeUpLines:
  - Hoy es el dia. El cohete esta listo...
  dialogueLines:
  - speaker: 0
    text: "\xA1Esta listo! Hoy nos vamos de este lugar."
  - speaker: 0
    text: Sube, hay un asiento para ti.
  - speaker: 1
    text: ...
  - speaker: 0
    text: "\xBFNo vienes?"
  - speaker: 1
    text: Es que... ese cohete es pura chatarra.
  - speaker: 1
    text: Mejor construyo uno mas grande. Y te alcanzo.
  - speaker: 0
    text: ...Entiendo. Te estare esperando, alla arriba.
